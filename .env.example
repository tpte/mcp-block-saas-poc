OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_PROVIDER_ONLY=Together
# 預設允許換 provider；設 false 才鎖死在 OPENROUTER_PROVIDER_ONLY
OPENROUTER_ALLOW_FALLBACKS=true
# 主模型失敗時的備援模型（逗號分隔；空字串＝關閉）
OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-v4-flash,google/gemini-3.8-flash
OPENROUTER_SITE_URL=http://localhost:5173
# Railway: set to https://<your-app>.up.railway.app (or leave unset to use RAILWAY_PUBLIC_DOMAIN)
PORT=8787
# Railway: mount volume at /app/.data and set MATRIX_VOLUME_MOUNTED=true
# MATRIX_VOLUME_MOUNTED=true
# MCP_STDIO_SERVERS=[{"name":"memory","command":"npx","args":["-y","@modelcontextprotocol/server-memory"]}]

# ── 身份與額度 ──
# 生產（NODE_ENV=production）預設 guest 模式：訪客自動拿到 24h 沙盒；本機預設 dev 模式（信任 X-User-Id）。
# MATRIX_AUTH_MODE=guest
# 管理操作（PUT /api/manifest、invites、/api/ops/*、platform:patch、建立工作區…）需 Authorization: Bearer <token>
MATRIX_ADMIN_TOKEN=
# 訪客每日模型對話上限、全站每日模型呼叫上限（admin 計入但不受限）
MATRIX_GUEST_CHAT_DAILY=20
MATRIX_LLM_DAILY_CAP=500
# MATRIX_GUEST_TTL_HOURS=24
# MATRIX_GUEST_MAX_ACTIVE=2000
# MATRIX_GUEST_CREATE_PER_IP_HOUR=20
# 訪客預設不能呼叫自架 stdio MCP（可能有副作用）
# MATRIX_GUEST_STDIO_CALLS=false
